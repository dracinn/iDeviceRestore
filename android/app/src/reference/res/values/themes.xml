<resources>
    <style name="Theme.IDeviceRestore" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/mock_primary</item>
        <item name="colorPrimaryVariant">@color/mock_primary_dark</item>
        <item name="colorSecondary">@color/mock_primary</item>
        <item name="android:windowBackground">@color/mock_background</item>
        <item name="android:statusBarColor">@color/mock_background</item>
        <item name="android:navigationBarColor">@color/mock_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialButtonStyle">@style/Widget.IDeviceRestore.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IDeviceRestore.Card</item>
    </style>
    <style name="Widget.IDeviceRestore.Card"><item name="cardCornerRadius">16dp</item><item name="cardElevation">0dp</item><item name="strokeColor">@color/mock_separator</item><item name="strokeWidth">1dp</item><item name="cardBackgroundColor">@color/mock_surface</item></style>
    <style name="Widget.IDeviceRestore.Button"><item name="cornerRadius">10dp</item><item name="android:minHeight">42dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">13sp</item></style>
    <style name="Widget.IDeviceRestore.BottomNavButton"><item name="android:minHeight">62dp</item><item name="android:textSize">10sp</item><item name="iconTint">@color/mock_text_secondary</item><item name="android:textColor">@color/mock_text_secondary</item></style>
    <style name="Widget.IDeviceRestore.QuickAction"><item name="cornerRadius">16dp</item><item name="android:minHeight">104dp</item><item name="strokeColor">@color/mock_separator</item><item name="strokeWidth">1dp</item><item name="backgroundTint">@color/mock_surface</item></style>
    <style name="Widget.IDeviceRestore.Segment"><item name="cornerRadius">8dp</item><item name="backgroundTint">@color/mock_surface_tertiary</item><item name="android:textColor">@color/mock_text_primary</item></style>
    <style name="TextAppearance.IDeviceRestore.ScreenTitle"><item name="android:textSize">22sp</item><item name="android:textColor">@color/mock_text_primary</item><item name="android:textStyle">bold</item></style>
</resources>
