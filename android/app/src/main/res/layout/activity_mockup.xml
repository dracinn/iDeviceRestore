<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_screen_horizontal"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/ui_screen_horizontal"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space android:layout_width="40dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iDeviceRestore"
                        android:textColor="@color/ui_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your Apple device. In good hands."
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/mockSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Settings"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/ui_text" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ui_surface"
                app:cardCornerRadius="@dimen/ui_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/ui_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_gravity="end"
                        android:background="@drawable/mock_reference_status_pill"
                        android:gravity="center"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="●  Recovery Mode"
                        android:textColor="@color/ui_success"
                        android:textSize="10sp" />

                    <ImageView
                        android:layout_width="145dp"
                        android:layout_height="94dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="MacBook Air"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mock_asset_macbook" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="MacBook Air (M1, Late 2020)"
                        android:textColor="@color/ui_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="2dp"
                        android:text="MacBookAir10,1"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="13dp" android:background="@color/ui_border" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Mode                         ●  Recovery Mode" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="ECID                          0x1C2E5A9B3D1E" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Serial                        FVFDP3Q1LMNH" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Latest Signed            26.6.2 (25G83)" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="13dp"
                        android:text="View Device Details      ›"
                        android:textAllCaps="false"
                        android:textColor="@color/ui_text"
                        app:backgroundTint="@color/ui_surface_soft"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mockRestore"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="@color/ui_surface"
                    app:cardCornerRadius="@dimen/ui_card_radius"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/mock_icon_circle" android:gravity="center" android:text="↶" android:textColor="@android:color/white" android:textSize="28sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Restore" android:textColor="@color/ui_text" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reinstall macOS" android:textColor="@color/ui_text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="@color/ui_surface"
                    app:cardCornerRadius="@dimen/ui_card_radius"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/mock_icon_circle" android:gravity="center" android:text="↓" android:textColor="@android:color/white" android:textSize="28sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Update" android:textColor="@color/ui_text" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Install latest signed" android:textColor="@color/ui_text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mockDiagnostics"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="@color/ui_surface"
                    app:cardCornerRadius="@dimen/ui_card_radius"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="♧" android:textColor="@color/ui_success" android:textSize="32sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Diagnostics" android:textColor="@color/ui_text" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check for issues" android:textColor="@color/ui_text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    app:cardBackgroundColor="@color/ui_surface"
                    app:cardCornerRadius="@dimen/ui_card_radius"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="•••" android:textColor="@color/ui_text_secondary" android:textSize="24sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="More Tools" android:textColor="@color/ui_text" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DFU, Utilities, etc." android:textColor="@color/ui_text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_bottom_nav_height"
        android:background="@color/ui_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="7dp"
        android:paddingBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="@color/ui_primary" android:textSize="11sp" />
        <TextView android:id="@+id/mockFirmware" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nFirmware" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▯\nDevices" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌘\nTools" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
