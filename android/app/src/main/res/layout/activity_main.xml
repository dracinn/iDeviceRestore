<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="iDeviceRestore"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Connect, verify firmware, and prepare the restore in clear stages."
                    android:textSize="14sp" />
            </LinearLayout>

            <com.idevicerestore.android.LogIconButton
                android:id="@+id/logsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Logs"
                android:minWidth="0dp"
                android:padding="12dp"
                android:text=""
                app:icon="@drawable/ic_logs"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Settings"
                android:minWidth="0dp"
                android:padding="12dp"
                android:text=""
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connected device"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No Apple USB device selected"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.idevicerestore.android.DfuGuideButton
                    android:id="@+id/dfuGuideButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DFU guide — connect a device in Recovery" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/operationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Restore preparation"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/operationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Waiting for device and firmware"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/operationProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:max="100"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/firmwareTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Firmware"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/firmwareStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Waiting for device identification"
                    android:textSize="15sp" />

                <com.idevicerestore.android.PercentProgressBar
                    android:id="@+id/firmwareProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:id="@+id/firmwareProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectFirmwareButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="Select signed firmware" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadFirmwareButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Download firmware" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelDownloadButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Cancel download" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Diagnostics"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Detailed USB, firmware, and restore information for testing and support."
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareLogsButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Share diagnostic report" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden session log sinks retained for MainActivity's existing logging pipeline. -->
        <TextView
            android:id="@+id/logView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/probeLogView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Legacy/next-stage controls remain present for existing view binding and staged restore work. -->
        <Button
            android:id="@+id/scanButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/probeButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.idevicerestore.android.TssTicketButton
            android:id="@+id/requestTssTicketButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.idevicerestore.android.Image4PrepareButton
            android:id="@+id/prepareIbssButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.idevicerestore.android.RestoreComponentPrepareButton
            android:id="@+id/prepareRestoreComponentsButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.idevicerestore.android.StartRestoreButton
            android:id="@+id/startRestoreButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:enabled="false"
            android:text="Start Restore"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
