<?xml version="1.0" encoding="utf-8"?>
<com.idevicerestore.android.InsetAwareShellLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mock_background"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iDeviceRestore"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Your Apple device. In good hands."
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Settings"
                    android:minWidth="0dp"
                    android:padding="8dp"
                    android:text=""
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/mock_text_primary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Connected device"
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.idevicerestore.android.UsbConnectionBadgeTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="○  No USB"
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.idevicerestore.android.BootStateStatusTextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="No Apple USB device selected"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Connect an Apple device by USB to identify model, mode, and firmware."
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="12sp" />

                    <com.idevicerestore.android.DfuGuideButton
                        android:id="@+id/dfuGuideButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="DFU guide — connect a device in Recovery" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Quick Actions"
                android:textColor="@color/mock_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.idevicerestore.android.MockupNavigationButton
                    android:id="@+id/quickRestoreButton"
                    style="@style/Widget.IDeviceRestore.QuickAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:tag="restore"
                    android:text="Restore\nReinstall macOS"
                    android:textColor="@color/mock_text_primary"
                    app:icon="@drawable/ic_restore"
                    app:iconGravity="top"
                    app:iconTint="@color/mock_restore" />

                <com.idevicerestore.android.MockupNavigationButton
                    android:id="@+id/quickUpdateButton"
                    style="@style/Widget.IDeviceRestore.QuickAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:tag="update"
                    android:text="Update\nInstall latest signed"
                    android:textColor="@color/mock_text_primary"
                    app:icon="@drawable/ic_firmware"
                    app:iconGravity="top"
                    app:iconTint="@color/mock_update" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.idevicerestore.android.MockupNavigationButton
                    android:id="@+id/quickDiagnosticsButton"
                    style="@style/Widget.IDeviceRestore.QuickAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:tag="diagnostics"
                    android:text="Diagnostics\nCheck for issues"
                    android:textColor="@color/mock_text_primary"
                    app:icon="@drawable/ic_tools"
                    app:iconGravity="top"
                    app:iconTint="@color/mock_diagnostics" />

                <com.idevicerestore.android.MockupNavigationButton
                    android:id="@+id/quickToolsButton"
                    style="@style/Widget.IDeviceRestore.QuickAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:tag="tools"
                    android:text="More Tools\nDFU, tests, logs"
                    android:textColor="@color/mock_text_primary"
                    app:icon="@drawable/ic_tools"
                    app:iconGravity="top"
                    app:iconTint="@color/mock_tools" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/operationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/operationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Restore preparation"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/operationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Waiting for device and firmware"
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/operationProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:max="100"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/firmwareSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/firmwareTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Firmware"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Browse, verify, and download Apple firmware."
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/firmwareStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Waiting for device identification"
                            android:textColor="@color/mock_text_primary"
                            android:textSize="13sp" />

                        <com.idevicerestore.android.FirmwareProgressTextView
                            android:id="@+id/firmwareProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.idevicerestore.android.PercentProgressBar
                        android:id="@+id/firmwareProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        android:progress="0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectFirmwareButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="Select signed firmware" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/downloadFirmwareButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Download firmware" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelDownloadButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Cancel download" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/diagnosticsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Diagnostics"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Analyze connection state, boot behavior, firmware readiness, and logs."
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="12sp" />

                    <com.idevicerestore.android.MockupNavigationButton
                        android:id="@+id/openDiagnosticsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:tag="diagnostics"
                        android:text="Open Boot Diagnostics" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareLogsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share diagnostic report" />

                    <com.idevicerestore.android.LogIconButton
                        android:id="@+id/logsButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Logs"
                        android:text="View logs"
                        app:icon="@drawable/ic_logs"
                        app:iconTint="@color/mock_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toolsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="M1 Recovery Tools"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="The current cumulative test automates DFU through the proven restore-entry boundary."
                        android:textColor="@color/mock_text_secondary"
                        android:textSize="12sp" />

                    <com.idevicerestore.android.BootStage2RecoveryButton
                        android:id="@+id/bootStage2RecoveryButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="Diagnostic: Boot Stage 2 Only" />

                    <com.idevicerestore.android.AutomatedStage2TestButton
                        android:id="@+id/stage2FirmwareBatchTestButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:text="Run Current Stage-2 Test" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/logView" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/probeLogView" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/scanButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/probeButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.idevicerestore.android.TssTicketButton android:id="@+id/requestTssTicketButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.idevicerestore.android.Image4PrepareButton android:id="@+id/prepareIbssButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.idevicerestore.android.RestoreComponentPrepareButton android:id="@+id/prepareRestoreComponentsButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.idevicerestore.android.PrearmedStage1IbecButton android:id="@+id/prearmedStage1IbecButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.idevicerestore.android.Stage2FirmwareBatchTestButton android:id="@+id/stage2FirmwareBatchTestDelegateButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mock_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/mock_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.idevicerestore.android.MockupNavigationButton
            android:id="@+id/navHomeButton"
            style="@style/Widget.IDeviceRestore.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="home"
            android:text="Home"
            android:textColor="@color/mock_primary"
            app:icon="@drawable/ic_home"
            app:iconTint="@color/mock_primary" />

        <com.idevicerestore.android.MockupNavigationButton
            android:id="@+id/navFirmwareButton"
            style="@style/Widget.IDeviceRestore.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="firmware"
            android:text="Firmware"
            app:icon="@drawable/ic_firmware" />

        <com.idevicerestore.android.MockupNavigationButton
            android:id="@+id/navDevicesButton"
            style="@style/Widget.IDeviceRestore.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="devices"
            android:text="Devices"
            app:icon="@drawable/ic_device" />

        <com.idevicerestore.android.MockupNavigationButton
            android:id="@+id/navToolsButton"
            style="@style/Widget.IDeviceRestore.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="tools"
            android:text="Tools"
            app:icon="@drawable/ic_tools" />
    </LinearLayout>
</com.idevicerestore.android.InsetAwareShellLayout>
