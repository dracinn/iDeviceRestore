<?xml version="1.0" encoding="utf-8"?>
<com.idevicerestore.android.InsetAwareShellLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mock_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME: matched to the supplied reference -->
        <ScrollView
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:layout_width="38dp" android:layout_height="38dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="iDeviceRestore"
                            android:textColor="@color/mock_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Your Apple device. In good hands."
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Settings"
                        android:minWidth="0dp"
                        android:padding="8dp"
                        android:text=""
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/mock_text_primary" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deviceSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="13dp"
                    app:strokeColor="@color/mock_separator"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:background="@drawable/mock_reference_status_pill"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="●  Recovery Mode"
                                android:textColor="@color/mock_success"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="134dp"
                            android:layout_height="86dp"
                            android:layout_gravity="center_horizontal"
                            android:contentDescription="MacBook"
                            android:scaleType="fitCenter"
                            android:src="@drawable/mock_asset_macbook" />

                        <TextView
                            android:id="@+id/deviceDisplayName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Connected Apple device"
                            android:textColor="@color/mock_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/deviceIdentifierText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Waiting for device identification"
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="9dp"
                            android:background="@color/mock_separator" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:columnCount="2"
                            android:rowCount="4">
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Mode" android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="● Recovery Mode" android:textColor="@color/mock_text_primary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="ECID" android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Protected in UI" android:textColor="@color/mock_text_primary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Serial" android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Protected in UI" android:textColor="@color/mock_text_primary" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Latest Signed" android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                            <TextView android:id="@+id/homeFirmwareSummary" android:layout_width="0dp" android:layout_height="22dp" android:layout_columnWeight="1" android:gravity="center_vertical" android:text="Select firmware" android:textColor="@color/mock_text_primary" android:textSize="11sp" />
                        </GridLayout>

                        <com.idevicerestore.android.BootStateStatusTextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="No Apple USB device found"
                            android:textColor="@color/mock_text_secondary"
                            android:textSize="10sp" />

                        <com.idevicerestore.android.MockupNavigationButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:tag="devices"
                            android:text="View Device Details    ›"
                            android:textColor="@color/mock_text_primary"
                            app:cornerRadius="9dp"
                            app:strokeColor="@color/mock_separator" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickRestoreButton"
                        style="@style/Widget.IDeviceRestore.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:alpha="1"
                        android:clickable="false"
                        android:enabled="false"
                        android:gravity="center"
                        android:text="Restore\nReinstall macOS"
                        android:textColor="@color/mock_text_primary"
                        app:icon="@drawable/mock_asset_restore"
                        app:iconGravity="top"
                        app:iconSize="48dp"
                        app:iconTint="@null" />
                    <com.idevicerestore.android.MockupNavigationButton
                        android:id="@+id/quickUpdateButton"
                        style="@style/Widget.IDeviceRestore.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:tag="update"
                        android:text="Update\nInstall latest signed"
                        android:textColor="@color/mock_text_primary"
                        app:icon="@drawable/mock_asset_update"
                        app:iconGravity="top"
                        app:iconSize="48dp"
                        app:iconTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.idevicerestore.android.MockupNavigationButton
                        android:id="@+id/quickDiagnosticsButton"
                        style="@style/Widget.IDeviceRestore.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:tag="diagnostics"
                        android:text="Diagnostics\nCheck for issues"
                        android:textColor="@color/mock_text_primary"
                        app:icon="@drawable/mock_asset_diagnostics"
                        app:iconGravity="top"
                        app:iconSize="48dp"
                        app:iconTint="@null" />
                    <com.idevicerestore.android.MockupNavigationButton
                        android:id="@+id/quickToolsButton"
                        style="@style/Widget.IDeviceRestore.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:tag="tools"
                        android:text="More Tools\nDFU, Utilities, etc."
                        android:textColor="@color/mock_text_primary"
                        app:icon="@drawable/mock_asset_tools"
                        app:iconGravity="top"
                        app:iconSize="48dp"
                        app:iconTint="@null" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- FIRMWARE: compact list treatment from the reference -->
        <ScrollView
            android:id="@+id/screenFirmware"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/TextAppearance.IDeviceRestore.ScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Firmware" />
                    <ImageButton android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="Downloads" android:padding="8dp" android:src="@drawable/ic_firmware" app:tint="@color/mock_text_primary" />
                    <TextView android:layout_width="28dp" android:layout_height="36dp" android:gravity="center" android:text="⋮" android:textColor="@color/mock_text_primary" android:textSize="22sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Browse, download, and manage\nApple firmware files." android:textColor="@color/mock_text_secondary" android:textSize="11sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="37dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/mock_reference_card"
                    android:enabled="false"
                    android:hint="⌕  Search devices (e.g. MacBookAir10,1)"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColorHint="@color/mock_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton style="@style/Widget.IDeviceRestore.Segment" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1" android:text="Mac" android:textColor="@android:color/white" app:backgroundTint="@color/mock_primary" />
                    <com.google.android.material.button.MaterialButton style="@style/Widget.IDeviceRestore.Segment" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1" android:text="iPhone" />
                    <com.google.android.material.button.MaterialButton style="@style/Widget.IDeviceRestore.Segment" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1" android:text="iPad" />
                    <com.google.android.material.button.MaterialButton style="@style/Widget.IDeviceRestore.Segment" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1" android:text="Watch" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="51dp" android:background="#EAF4FF" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="8dp">
                            <ImageView android:layout_width="48dp" android:layout_height="32dp" android:contentDescription="MacBook" android:src="@drawable/mock_asset_macbook" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connected Mac" android:textColor="@color/mock_text_primary" android:textSize="12sp" android:textStyle="bold" />
                                <TextView android:id="@+id/firmwareTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Waiting for connected device" android:textColor="@color/mock_text_secondary" android:textSize="10sp" />
                            </LinearLayout>
                            <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/mock_primary" android:textSize="22sp" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mock_separator" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="51dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="8dp">
                            <ImageView android:layout_width="48dp" android:layout_height="32dp" android:alpha="0.78" android:contentDescription="MacBook" android:src="@drawable/mock_asset_macbook" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MacBook Pro" android:textColor="@color/mock_text_primary" android:textSize="12sp" android:textStyle="bold" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Browse support planned" android:textColor="@color/mock_text_secondary" android:textSize="10sp" />
                            </LinearLayout>
                            <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/mock_text_secondary" android:textSize="22sp" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mock_separator" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="51dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="8dp">
                            <ImageView android:layout_width="48dp" android:layout_height="32dp" android:alpha="0.55" android:contentDescription="Mac" android:src="@drawable/mock_asset_macbook" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mac mini / Intel Mac" android:textColor="@color/mock_text_primary" android:textSize="12sp" android:textStyle="bold" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Browse support planned" android:textColor="@color/mock_text_secondary" android:textSize="10sp" />
                            </LinearLayout>
                            <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/mock_text_secondary" android:textSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/TextAppearance.IDeviceRestore.SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Available Firmware" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See All" android:textColor="@color/mock_primary" android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/firmwareSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Latest selected build" android:textColor="@color/mock_text_primary" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:layout_width="54dp" android:layout_height="21dp" android:background="@drawable/mock_reference_status_pill" android:gravity="center" android:text="Signed" android:textColor="@color/mock_success" android:textSize="9sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/firmwareStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for device identification" android:textColor="@color/mock_text_secondary" android:textSize="10sp" />
                        <com.idevicerestore.android.PercentProgressBar android:id="@+id/firmwareProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" android:max="1000" android:progress="0" />
                        <com.idevicerestore.android.FirmwareProgressTextView android:id="@+id/firmwareProgressText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="end" android:textColor="@color/mock_text_secondary" android:textSize="9sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/selectFirmwareButton" android:layout_width="match_parent" android:layout_height="39dp" android:layout_marginTop="7dp" android:enabled="false" android:text="Select signed firmware" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/downloadFirmwareButton" android:layout_width="match_parent" android:layout_height="39dp" android:enabled="false" android:text="Download firmware" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/cancelDownloadButton" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="36dp" android:enabled="false" android:text="Cancel" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- DEVICES -->
        <ScrollView android:id="@+id/screenDevices" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView style="@style/TextAppearance.IDeviceRestore.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Devices" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Connected Apple device information." android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="14dp">
                        <ImageView android:layout_width="134dp" android:layout_height="86dp" android:contentDescription="MacBook" android:src="@drawable/mock_asset_macbook" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Current connected device" android:textColor="@color/mock_text_primary" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Live USB state is shown on Home and in Boot Diagnostics." android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- TOOLS -->
        <ScrollView android:id="@+id/screenTools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView style="@style/TextAppearance.IDeviceRestore.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tools" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Verified utilities in the main app. Experimental work stays in Boot Diagnostics." android:textColor="@color/mock_text_secondary" android:textSize="11sp" />
                <com.idevicerestore.android.MockupNavigationButton android:id="@+id/openDiagnosticsButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:tag="boot_diagnostics" android:text="Boot Diagnostics" />
                <com.google.android.material.button.MaterialButton android:id="@+id/shareLogsButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="Share diagnostic report" />
                <com.idevicerestore.android.AutomatedStage2TestButton android:id="@+id/stage2FirmwareBatchTestButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Reference bottom tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/mock_surface"
        android:orientation="vertical">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mock_nav_border" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="63dp" android:orientation="horizontal">
            <com.idevicerestore.android.MockupNavigationButton android:id="@+id/navHomeButton" style="@style/Widget.IDeviceRestore.BottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:tag="home" android:text="Home" android:textColor="@color/mock_primary" app:icon="@drawable/ic_home" app:iconTint="@color/mock_primary" />
            <com.idevicerestore.android.MockupNavigationButton android:id="@+id/navFirmwareButton" style="@style/Widget.IDeviceRestore.BottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:tag="firmware" android:text="Firmware" app:icon="@drawable/ic_firmware" />
            <com.idevicerestore.android.MockupNavigationButton android:id="@+id/navDevicesButton" style="@style/Widget.IDeviceRestore.BottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:tag="devices" android:text="Devices" app:icon="@drawable/ic_devices" />
            <com.idevicerestore.android.MockupNavigationButton android:id="@+id/navToolsButton" style="@style/Widget.IDeviceRestore.BottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:tag="tools" android:text="Tools" app:icon="@drawable/ic_tools" />
        </LinearLayout>
    </LinearLayout>

    <!-- Existing functional delegates retained but not allowed to dictate visible styling. -->
