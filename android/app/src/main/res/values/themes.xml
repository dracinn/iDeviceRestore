<resources>
    <style name="Theme.IDeviceRestore" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mock_primary</item>
        <item name="colorPrimaryVariant">@color/mock_primary_dark</item>
        <item name="colorSecondary">@color/mock_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/mock_background</item>
        <item name="android:statusBarColor">@color/mock_background</item>
        <item name="android:navigationBarColor">@color/mock_surface</item>
        <item name="materialButtonStyle">@style/Widget.IDeviceRestore.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IDeviceRestore.Card</item>
    </style>

    <style name="Widget.IDeviceRestore.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mock_separator</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/mock_surface</item>
    </style>

    <style name="Widget.IDeviceRestore.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.IDeviceRestore.BottomNavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconTint">@color/mock_text_secondary</item>
        <item name="android:textColor">@color/mock_text_secondary</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.IDeviceRestore.QuickAction" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">92dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/mock_separator</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/mock_surface</item>
    </style>
</resources>
